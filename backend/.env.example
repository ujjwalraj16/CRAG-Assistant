# CRAG AI (NEXUS AI) Backend Configuration
# Copy this file to .env and fill in values as needed.

# Application
APP_NAME="CRAG AI"
DEBUG=false
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=90

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tavily External Web Search (Optional - leave blank to run offline/internal only)
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# Retrieval & CRAG Pipeline Parameters
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.25
MAX_CORRECTION_ATTEMPTS=1
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Storage Paths (relative to backend/ directory)
DATA_DIR=data
UPLOAD_DIR=data/uploads
FAISS_INDEX_DIR=data/faiss_index
DATABASE_PATH=data/crag.db

